# With NONE of the required variables set, the deployment runs in demo mode: the whole game in the visitor's browser,
# with a simulated show floor (README → "Deploy"). Set all three below to go live.

# ---- Required on Vercel (Project → Settings → Environment Variables) ----
# Supabase Postgres (project "Mihas", Tokyo). Supabase → Connect → Transaction pooler (port 6543), with the database
# password filled in. The schema is created on first start (and was applied as the migration `mission_x_schema`).
# Also works locally: with DATABASE_URL set, `npm run dev` uses it instead of the SQLite file in data/.
DATABASE_URL=postgresql://postgres.inokhtsjbmfadudnkdpt:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres
# Signs player sessions, Golden Tickets, beacons and host codes. 32+ random characters. Changing it logs everyone out
# and invalidates every printed beacon QR.
MX_SECRET=
# What booth staff type into /crew.html
CREW_PIN=

# ---- Optional ----
# Only needed with a custom domain; otherwise derived from Vercel's own URL.
# PUBLIC_ORIGIN=https://play.example.com
# Venue check-in circle (defaults: MITEC, 400 m)
# VENUE_LAT=3.17811
# VENUE_LON=101.66864
# VENUE_RADIUS_M=400
# Skip the idempotent schema script on cold start once the database is set up
# MX_SKIP_MIGRATE=1
# The Playground's daily bridge: the first finished run of the day pays 50 fair points, once. Off until the crew says so.
# PLAYGROUND_DAILY=1
